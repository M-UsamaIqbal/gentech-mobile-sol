# Database (Required)
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/gentech"
DIRECT_URL=""

# Better Auth (Required)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-secret"
# Optional URL overrides for non-Vercel deployments; Vercel origins are auto-detected.
# BETTER_AUTH_URL="http://localhost:3000"
# APP_URL="http://localhost:3000"

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# Cloudinary Media (Optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Transactional Email (Optional)
RESEND_API_KEY=""
EMAIL_FROM=""

# PayFast direct API (Optional; live processing must remain disabled until review)
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
PAYFAST_API_BASE=""
PAYFAST_MERCHANT_CATEGORY_CODE=""
PAYFAST_CARD_ACCOUNT_TYPE=""
PAYFAST_JAZZCASH_BANK_CODE=""
PAYFAST_JAZZCASH_ACCOUNT_TYPE=""
PAYFAST_EASYPAISA_BANK_CODE=""
PAYFAST_EASYPAISA_ACCOUNT_TYPE=""
PAYFAST_MODE="disabled"
PAYFAST_LIVE_ENABLED="false"
# Test-only: enables the built-in simulated JazzCash/Easypaisa/card gateway in a
# production build (preview/staging) when PayFast credentials are absent.
# NEVER enable on a public production deployment — it marks payments as paid
# without a real charge.
PAYMENTS_TEST_MODE="false"

# PTA / CPID Device Verification (Optional)
# Test-only: simulate PTA/CPID results in a production build. Results are stored
# and displayed as simulated; never enable on public production. Real regulatory
# checks require a provider adapter with merchant/API access.
DEVICE_VERIFICATION_TEST_MODE="false"

# Firebase Cloud Messaging (Optional, server-side only)
# Never use the NEXT_PUBLIC_ prefix for service-account credentials.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Sell Your Phone AI grading (Optional; deterministic DEV grader when unset)
ANTHROPIC_API_KEY=""
ANTHROPIC_VISION_MODEL=""

# Scheduled jobs (Optional; guards internal cron endpoints)
CRON_SECRET=""

# Twilio phone OTP for inspection booking (Optional; DEV provider logs codes)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_OTP_CHANNEL="sms"

# Google Maps (Optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Analytics (Optional)
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_MIXPANEL_TOKEN=""

# Browser-side SF3D generation (Optional — see docs/SF3D_WEBGPU.md before enabling).
# Leave disabled until the runtime/model licence review is documented.
NEXT_PUBLIC_SF3D_ENABLED="false"
NEXT_PUBLIC_SF3D_WEIGHTS_URL=""
NEXT_PUBLIC_SF3D_WEIGHTS_BYTES=""
NEXT_PUBLIC_SF3D_WEIGHTS_ETAG=""

# Application (Required)
NEXT_PUBLIC_APP_NAME="GenTech"

# Node Environment
NODE_ENV="development"
