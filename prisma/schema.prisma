// GenTech Marketplace — Prisma schema
// Phase 1: identity & access (Better Auth models) + user profile.
// Catalog / messaging / reviews models are added in later phases.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
  runtime  = "nodejs"
}

// Prisma 7: connection URLs live in prisma.config.ts (migrations) and the
// runtime driver adapter (client). The datasource only declares the provider.
datasource db {
  provider = "postgresql"
}

/// Coarse-grained authorization role. A single account buys *and* sells;
/// ADMIN is a privileged superset. Kept in sync with `USER_ROLES` in lib/constants.ts.
enum Role {
  USER
  INSPECTOR
  ADMIN
}

// ---------------------------------------------------------------------------
// Better Auth core models (field names must match Better Auth's expectations).
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Application fields
  role      Role      @default(USER)
  banned    Boolean   @default(false)
  banReason String?
  deletedAt DateTime?

  // Relations — auth
  sessions Session[]
  accounts Account[]
  profile  Profile?

  // Relations — marketplace
  listings              Listing[]
  favorites             Favorite[]
  savedSearches         SavedSearch[]
  sentMessages          Message[]      @relation("MessageSender")
  buyerConversations    Conversation[] @relation("ConversationBuyer")
  sellerConversations   Conversation[] @relation("ConversationSeller")
  reviewsAuthored       Review[]       @relation("ReviewAuthor")
  reviewsReceived       Review[]       @relation("ReviewTarget")
  reportsFiled          Report[]       @relation("ReportReporter")
  reportsAgainst        Report[]       @relation("ReportTargetUser")
  notifications         Notification[]

  // Relations — inspections
  inspectionRequests  InspectionRequest[] @relation("InspectionRequester")
  inspectionsAssigned InspectionRequest[] @relation("InspectionInspector")
  phoneVerifications  PhoneVerification[]

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Application: extended user profile (1:1 with User).
// ---------------------------------------------------------------------------

model Profile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio        String?
  phone      String?
  coverImage String?
  // Location (denormalised; PostGIS geometry added in the discovery phase)
  city       String?
  address    String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("profile")
}

// ---------------------------------------------------------------------------
// Catalog: categories, brands, listings, media.
// ---------------------------------------------------------------------------

/// Physical condition of an item. Tuned for phones but reusable for any product.
enum ListingCondition {
  NEW
  OPEN_BOX
  USED
  REFURBISHED
  FOR_PARTS
}

/// Lifecycle state machine for a listing.
enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
}

/// Self-referential category tree (e.g. Mobile Phones → Smartphones).
model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  icon        String?
  image       String?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
  @@map("category")
}

/// Manufacturer/brand (Apple, Samsung, ...). Enables brand pages and filters.
model Brand {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  logo     String?
  position Int     @default(0)
  isActive Boolean @default(true)

  listings Listing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("brand")
}

model Listing {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String

  // Pricing — ALWAYS Decimal, never Float.
  price      Decimal @db.Decimal(12, 2)
  currency   String  @default("PKR")
  negotiable Boolean @default(false)

  condition ListingCondition
  status    ListingStatus    @default(ACTIVE)

  /// Category-specific structured attributes (storage, ram, color, batteryHealth,
  /// ptaApproved, ...). Validated by a per-category Zod schema at the app layer.
  attributes Json?

  // Media
  videoUrl String?

  /// Full-text search vector over title + description. Populated by the app on
  /// create/update (see listing.repository) and queried with ts_rank.
  searchVector Unsupported("tsvector")?

  // Location (denormalised; PostGIS geometry added in the discovery phase)
  city      String?
  area      String?
  latitude  Float?
  longitude Float?

  // Engagement metrics
  views         Int     @default(0)
  isFeatured    Boolean @default(false)
  featuredUntil DateTime?

  // Relations
  sellerId String
  seller   User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]
  reviews       Review[]
  inspections   InspectionRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  soldAt    DateTime?
  expiresAt DateTime?
  deletedAt DateTime?

  @@index([status, createdAt])
  @@index([categoryId, status])
  @@index([brandId])
  @@index([sellerId])
  @@index([isFeatured, status])
  @@index([city])
  @@index([searchVector], type: Gin)
  @@map("listing")
}

model ListingImage {
  id          String  @id @default(cuid())
  url         String
  publicId    String? // Cloudinary public id (for deletion/transforms)
  width       Int?
  height      Int?
  blurDataUrl String?
  position    Int     @default(0)
  isPrimary   Boolean @default(false)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([listingId])
  @@map("listing_image")
}

// ---------------------------------------------------------------------------
// Engagement: favorites + saved searches.
// ---------------------------------------------------------------------------

model Favorite {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([listingId])
  @@map("favorite")
}

model SavedSearch {
  id      String  @id @default(cuid())
  name    String?
  /// The query string + structured filters (category, price range, condition, ...).
  query   String?
  filters Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("saved_search")
}

// ---------------------------------------------------------------------------
// Messaging: a conversation is scoped to a listing between a buyer and seller.
// ---------------------------------------------------------------------------

model Conversation {
  id String @id @default(cuid())

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  buyerId String
  buyer   User   @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  sellerId String
  seller   User   @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)

  messages      Message[]
  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId])
  @@index([sellerId])
  @@map("conversation")
}

model Message {
  id       String  @id @default(cuid())
  body     String?
  imageUrl String?

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([conversationId, createdAt])
  @@map("message")
}

// ---------------------------------------------------------------------------
// Reviews: directed ratings between users, optionally tied to a listing.
// ---------------------------------------------------------------------------

model Review {
  id      String @id @default(cuid())
  rating  Int // 1..5, enforced at the application layer
  comment String?

  authorId String
  author   User   @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  targetUserId String
  targetUser   User   @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authorId, targetUserId, listingId])
  @@index([targetUserId])
  @@map("review")
}

// ---------------------------------------------------------------------------
// Moderation: reports + notifications.
// ---------------------------------------------------------------------------

enum ReportReason {
  SPAM
  SCAM_OR_FRAUD
  PROHIBITED_ITEM
  COUNTERFEIT
  OFFENSIVE
  WRONG_CATEGORY
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id      String       @id @default(cuid())
  reason  ReportReason
  details String?
  status  ReportStatus @default(OPEN)

  reporterId String
  reporter   User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  reportedUserId String?
  reportedUser   User?   @relation("ReportTargetUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("report")
}

enum NotificationType {
  MESSAGE
  LISTING_SOLD
  LISTING_EXPIRED
  NEW_REVIEW
  PRICE_DROP
  SYSTEM
  INSPECTION_REQUESTED
  INSPECTION_SCHEDULED
  INSPECTION_COMPLETED
}

model Notification {
  id    String           @id @default(cuid())
  type  NotificationType
  title String
  body  String?
  /// Arbitrary payload (e.g. { listingId, conversationId }).
  data  Json?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notification")
}

// ---------------------------------------------------------------------------
// Inspection: professional pre-purchase checks (PakWheels-style) for a listing.
// An in-house inspector (User with role INSPECTOR) physically verifies a phone
// and publishes a graded report the buyer can trust.
// ---------------------------------------------------------------------------

/// Lifecycle of an inspection request.
enum InspectionStatus {
  REQUESTED
  PAYMENT_PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

/// Payment state of the inspection fee.
enum InspectionPaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

/// Inspector's overall buy recommendation on the finished report.
enum InspectionVerdict {
  RECOMMENDED
  RECOMMENDED_WITH_NOTES
  NOT_RECOMMENDED
}

/// Result for a single checklist line (screen, battery, camera, ...).
enum InspectionItemResult {
  PASS
  MINOR_ISSUE
  MAJOR_ISSUE
  NOT_APPLICABLE
}

/// A priced inspection package (Basic / Comprehensive / ...). Admin-managed.
model InspectionPlan {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  /// Fee — ALWAYS Decimal, never Float.
  price       Decimal @db.Decimal(12, 2)
  currency    String  @default("PKR")
  /// How many checkpoints this tier covers (for marketing copy).
  checkpoints Int     @default(0)
  /// Ordered list of what's included, for the pricing page.
  features    Json?
  position    Int     @default(0)
  isActive    Boolean @default(true)

  requests InspectionRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("inspection_plan")
}

/// A buyer's request to have a specific listing physically inspected.
model InspectionRequest {
  id     String           @id @default(cuid())
  status InspectionStatus @default(REQUESTED)

  // Who + what
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  requesterId String
  requester   User   @relation("InspectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  // Assigned in-house inspector (User with role INSPECTOR)
  inspectorId String?
  inspector   User?   @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)

  // Chosen package + fee snapshot (plan may change/deactivate later)
  planId    String?
  plan      InspectionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  planName  String?
  feeAmount Decimal         @db.Decimal(12, 2)
  currency  String          @default("PKR")

  paymentStatus InspectionPaymentStatus @default(UNPAID)
  /// Gateway transaction reference (aggregator order id).
  paymentRef    String?
  /// Method the buyer chose: jazzcash | easypaisa | card.
  paymentMethod String?
  paidAt        DateTime?

  // Free-text phone being inspected when the request isn't tied to a listing
  // (e.g. a buyer booking an inspection for a phone found off-platform).
  deviceInfo String?

  // Where the inspection happens + how to reach the requester
  contactName  String?
  contactPhone String?
  city         String?
  area         String?
  address      String?
  latitude     Float?
  longitude    Float?
  notes        String?

  // Scheduling
  preferredAt  DateTime?
  scheduledAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  report InspectionReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId, status])
  @@index([inspectorId, status])
  @@index([listingId])
  @@index([status, scheduledAt])
  @@map("inspection_request")
}

/// The report produced for one request. Private to the requester until published.
model InspectionReport {
  id String @id @default(cuid())

  requestId String            @unique
  request   InspectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  // 0..100 aggregate, plus a human grade + buy recommendation.
  overallScore Int
  grade        String?
  verdict      InspectionVerdict
  summary      String?

  // First-class phone trust signals (Pakistan market).
  imei          String?
  ptaApproved   Boolean?
  batteryHealth Int?

  // Trust/visibility: buyer-only by default, publishable onto the listing.
  isPublished Boolean   @default(false)
  publishedAt DateTime?

  items  InspectionReportItem[]
  photos InspectionPhoto[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verdict])
  @@map("inspection_report")
}

/// One graded checklist line (Display, Battery, Camera, Body, Ports, ...).
model InspectionReportItem {
  id       String               @id @default(cuid())
  category String
  label    String
  result   InspectionItemResult @default(PASS)
  score    Int?
  comment  String?
  position Int                  @default(0)

  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("inspection_report_item")
}

/// Photo captured during the inspection (reuses the Cloudinary pattern).
model InspectionPhoto {
  id          String  @id @default(cuid())
  url         String
  publicId    String?
  width       Int?
  height      Int?
  blurDataUrl String?
  caption     String?
  position    Int     @default(0)

  reportId String
  report   InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("inspection_photo")
}

/// Short-lived phone OTP used to confirm a buyer's WhatsApp/SMS number before
/// they can book an inspection. One live row per (user, phone) — upserted on
/// each resend. The code is stored hashed; verification is valid for a short
/// window (see `OTP.validForMinutes` in lib/constants.ts).
model PhoneVerification {
  id         String    @id @default(cuid())
  userId     String
  /// Normalized E.164 number (e.g. +923001234567).
  phone      String
  /// SHA-256 hash of the OTP — never the plaintext code.
  codeHash   String
  /// Delivery channel the code was sent over ("sms" | "whatsapp").
  channel    String    @default("sms")
  /// Failed check attempts against the current code.
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@index([userId])
  @@map("phone_verification")
}
